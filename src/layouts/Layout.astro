---
import socialImageUrl from "@/assets/images/og-preview.png"

interface Props {
  title?: string
}

const { title } = Astro.props

const DESCRIPTION = "Transforming curious learners into tech visionaries 🚀"
const DEFAULT_TITLE = "Studevs"
const ogTitle = title ? `${DEFAULT_TITLE} | ${title}` : DEFAULT_TITLE

// https://docs.astro.build/en/reference/api-reference/#astrourl
// Construct a canonical URL using your production domain
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const TWITTER_HANDLE = "@StuDevsOfficial"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.cdnfonts.com/css/aileron" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url" content={canonicalURL} />
    <!-- <meta property="og:image" content={socialImageUrl.src} /> -->

    <meta property="twitter:title" content={DEFAULT_TITLE} />
    <meta property="twitter:description" content={DESCRIPTION} />

    <meta property="twitter:title" content={ogTitle} />
    <meta property="twitter:description" content={DESCRIPTION} />
    <meta property="twitter:image" content={socialImageUrl.src} />
    <meta property="twitter:site" content={TWITTER_HANDLE} />
    <meta property="twitter:creator" content={TWITTER_HANDLE} />
    <meta property="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  @import url("https://fonts.cdnfonts.com/css/aileron");

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background-color: #0e1239;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: auto;
    font-family: "Aileron", sans-serif;
  }

  #logoStudevs {
    margin: 40px 0 20px 0;
    height: 30vh;
    width: 30vw;
    object-fit: contain;
  }

  /* h1 {
        font-size: 5rem;
        font-weight: 950;
        color: aliceblue;
    } */
  #txt {
    width: 40vw;
  }

  #logos {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    width: 50vw;
    margin: 5rem 0;
  }

  #logos img {
    width: 7vw;
    margin: 0 10px;
    transition: 0.5s;
    width: 5rem;
    height: 5rem;
    aspect-ratio: 1/1;
  }

  #logos img:hover {
    transform: scale(1.1);
  }

  #logos .container {
    background-color: #0111a500;
  }

  #logos .container p {
    display: none;
  }

  #upcomingEvent {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 50vw;
    margin: 2rem 0 5rem 0;
  }

  #upcomingEvent h2 {
    color: #ffffff;
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-align: center;
    letter-spacing: 0.5px;
  }

  #upcomingEvent .event-card {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
  }

  #upcomingEvent .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }

  #upcomingEvent .event-image {
    width: 100%;
    max-width: 700px;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
    display: block;
  }

  /*!--------MEDIA QUERIES------- */

  @media screen and (max-width: 1034px) {
    #logoStudevs {
      height: 20vh;
      width: 20vw;
    }

    #txt {
      width: 50vw;
    }

    #logos {
      width: 70vw;
      flex-direction: column;
      height: auto;
    }

    #logos img {
      width: 07vw;
      margin: 10px 40px;
    }

    #logos .container {
      display: flex;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      background-color: #3b3b3b73;
      width: 100%;
      /* height: 08vh; */
      border-radius: 50px;
      margin-bottom: 20px;
    }

    #logos .container p {
      display: flex;
      color: white;
      width: 80%;
      margin-left: 05vw;

      font-size: 1.5rem;
      font-weight: 800;
    }

    #upcomingEvent {
      width: 85vw;
      margin: 1rem 0 3rem 0;
    }

    #upcomingEvent h2 {
      font-size: 1.75rem;
      margin-bottom: 1rem;
    }

    #upcomingEvent .event-card {
      padding: 0.75rem;
      border-radius: 16px;
    }
  }
</style>
